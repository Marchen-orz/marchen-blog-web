---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import { siteConfig } from "@/data/site";

export const prerender = false;

const hasPrivateAccess =
  Astro.cookies.get(siteConfig.privateCookieKey)?.value === siteConfig.privateCookieValue;

if (!hasPrivateAccess) {
  Astro.response.status = 404;
}
---

<BaseLayout
  title={hasPrivateAccess ? "个人知识库" : "页面未找到"}
  description={hasPrivateAccess ? "Marchen 的私有知识库入口。" : "这个页面不存在或暂时不可访问。"}
>
  {
    hasPrivateAccess ? (
      <div class="page-shell page">
        <section class="page-hero paper-card">
          <p class="eyebrow">Private KB</p>
          <h1>个人知识库</h1>
          <p>这是预留给个人使用的知识库入口。后续接入第三方知识库问答 API。</p>
        </section>

        <section class="paper-card kb-panel">
          <span class="tape" aria-hidden="true"></span>
          <Icon name="BrainCircuit" size={32} />
          <h2>知识库问答预留</h2>
          <p>后续这里会接入 <code>/api/kb/ask</code>，由服务端转发到第三方知识库 API，并展示回答与引用来源。</p>
          <form>
            <label for="question">问题</label>
            <textarea id="question" placeholder="例如：我之前写过哪些关于 Astro 的内容？"></textarea>
            <button type="button">API 接入后启用</button>
          </form>
        </section>
      </div>
    ) : (
      <div class="page-shell page">
        <section class="paper-card not-found">
          <span class="tape" aria-hidden="true"></span>
          <Icon name="FileQuestion" size={38} />
          <p class="eyebrow">404</p>
          <h1>页面未找到</h1>
          <p>你访问的页面不存在，或者暂时不可访问。</p>
          <a class="button" href="/"><Icon name="ArrowLeft" size={18} /> 返回首页</a>
        </section>
      </div>
    )
  }
</BaseLayout>

<style>
  .page {
    display: grid;
    gap: 24px;
  }

  .page-hero,
  .kb-panel,
  .not-found {
    padding: 34px;
  }

  h1 {
    margin: 10px 0;
    font-size: clamp(2.3rem, 6vw, 4rem);
  }

  .page-hero p:last-child,
  .kb-panel p,
  .not-found p {
    max-width: 760px;
    color: var(--muted);
  }

  h2 {
    margin: 12px 0 8px;
  }

  code {
    border-radius: 6px;
    background: #f1eadf;
    padding: 2px 6px;
    color: #92310a;
  }

  form {
    display: grid;
    gap: 10px;
    max-width: 760px;
    margin-top: 20px;
  }

  label {
    font-weight: 900;
  }

  textarea {
    min-height: 170px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: #fffdf8;
    padding: 14px;
    color: var(--ink);
    resize: vertical;
  }

  button {
    justify-self: start;
    border: 1px solid #e1cfae;
    border-radius: 10px;
    background: var(--accent-soft);
    padding: 9px 14px;
    color: #6b2e05;
    font-weight: 900;
  }

  .not-found {
    min-height: 440px;
    display: grid;
    align-content: center;
    justify-items: start;
  }

  .not-found h1 {
    margin-bottom: 8px;
  }

  .not-found .button {
    margin-top: 18px;
    padding: 0 16px;
  }
</style>
