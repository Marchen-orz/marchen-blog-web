---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import ToolFavoriteCard from "@/components/ToolFavoriteCard.astro";
import { favorites } from "@/data/favorites";
import { projects } from "@/data/projects";
import { siteConfig, nowItems } from "@/data/site";
import { tools } from "@/data/tools";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft && post.data.visibility === "public")
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const notes = (await getCollection("notes"))
  .filter((note) => note.data.visibility === "public")
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const featuredProjects = projects.filter((item) => item.featured).slice(0, 3);
const featuredTools = tools.filter((item) => item.featured).slice(0, 4);
const featuredFavorites = favorites.filter((item) => item.featured).slice(0, 4);
---

<BaseLayout title="Marchen 的数字花园" description={siteConfig.description}>
  <div class="page-shell home">
    <section class="hero paper-card">
      <span class="tape" aria-hidden="true"></span>
      <div class="hero-copy">
        <p class="eyebrow">Digital Garden</p>
        <h1>Hi，我是 <span>Marchen</span></h1>
        <p class="lead">一名热爱前端、系统设计和知识整理的学习者。这里记录技术文章、项目日志、日常碎念和收藏工具。</p>
        <div class="hero-actions">
          <a class="button" href="/about"><Icon name="UserRound" size={18} /> 关于我</a>
          <a class="button secondary" href="/blog"><Icon name="BookOpen" size={18} /> 看文章</a>
        </div>
        <div class="social-row">
          {siteConfig.socials.map((item) => (
            <a href={item.href} aria-label={item.name}><Icon name={item.icon} size={19} /> {item.name}</a>
          ))}
        </div>
      </div>
      <aside class="profile-note">
        <img src={siteConfig.avatar} alt="Marchen 的头像插画" />
        <strong>Marchen</strong>
        <p>记录 · 分享 · 探索 · 成长</p>
        <div class="stats">
          <span><b>{posts.length}</b> 近期文章</span>
          <span><b>{projects.length}</b> 项目</span>
          <span><b>{tools.length}</b> 工具</span>
        </div>
      </aside>
      <div class="hand-note">
        写博客不是为了输出正确答案，而是为了留下思考过的痕迹。
      </div>
    </section>

    <section class="now-strip paper-card">
      <p class="eyebrow">Recent Updates</p>
      <div class="timeline-line">
        {nowItems.map((item, index) => (
          <span><b>5.{12 - index}</b>{item}</span>
        ))}
      </div>
    </section>

    <section>
      <div class="section-header">
        <div>
          <p class="eyebrow">Writing</p>
          <h2 class="section-title">最近写下</h2>
        </div>
        <a class="plain-link" href="/blog">查看全部 <Icon name="ArrowRight" size={16} /></a>
      </div>
      <div class="post-list">
        {posts.map((post) => (
          <ArticleCard
            href={`/blog/${post.id}`}
            title={post.data.title}
            description={post.data.description}
            date={post.data.pubDate}
            tags={post.data.tags}
            cover={post.data.cover}
          />
        ))}
      </div>
    </section>

    <section class="split">
      <div>
        <div class="section-header">
          <div>
            <p class="eyebrow">Projects</p>
            <h2 class="section-title">精选项目</h2>
          </div>
          <a class="plain-link" href="/projects">全部项目 <Icon name="ArrowRight" size={16} /></a>
        </div>
        <div class="grid-auto">
          {featuredProjects.map((project) => <ProjectCard project={project} />)}
        </div>
      </div>
      <aside class="sticky-notes">
        <div class="paper-card memo yellow">
          <span>今日一句</span>
          <p>慢下来，才能走得更远。</p>
        </div>
        <div class="paper-card memo">
          <span>最近碎念</span>
          {notes.map((note) => <a href="/notes">{note.data.title}</a>)}
        </div>
      </aside>
    </section>

    <section class="double-grid">
      <div>
        <div class="section-header">
          <div>
            <p class="eyebrow">Toolbox</p>
            <h2 class="section-title">我的工具箱</h2>
          </div>
          <a class="plain-link" href="/tools">更多工具 <Icon name="ArrowRight" size={16} /></a>
        </div>
        <div class="mini-grid">
          {featuredTools.map((tool) => (
            <ToolFavoriteCard title={tool.name} description={tool.description} href={tool.href} icon={tool.icon} label={tool.category} />
          ))}
        </div>
      </div>
      <div>
        <div class="section-header">
          <div>
            <p class="eyebrow">Favorites</p>
            <h2 class="section-title">常去的地方</h2>
          </div>
          <a class="plain-link" href="/favorites">全部收藏 <Icon name="ArrowRight" size={16} /></a>
        </div>
        <div class="mini-grid">
          {featuredFavorites.map((favorite) => (
            <ToolFavoriteCard title={favorite.title} description={favorite.description} href={favorite.url} icon={favorite.icon} label={favorite.category} />
          ))}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .home {
    display: grid;
    gap: 46px;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: 30px;
    min-height: 430px;
    overflow: hidden;
    padding: 54px 46px 38px;
  }

  .hero-copy h1 {
    margin: 16px 0 14px;
    max-width: 680px;
    font-size: clamp(2.5rem, 7vw, 5rem);
    line-height: 1.03;
    letter-spacing: 0;
  }

  .hero-copy h1 span {
    position: relative;
    display: inline-block;
    color: #1d4ed8;
  }

  .hero-copy h1 span::after {
    position: absolute;
    right: 0;
    bottom: 0.08em;
    left: 0;
    height: 10px;
    border-radius: 999px;
    background: rgba(249, 115, 22, 0.45);
    content: "";
    z-index: -1;
  }

  .lead {
    max-width: 620px;
    margin: 0;
    color: var(--muted);
    font-size: 1.1rem;
  }

  .hero-actions,
  .social-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
  }

  .button {
    padding: 0 16px;
  }

  .button.secondary {
    background: #f8fbff;
    color: #173142;
  }

  .social-row a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: #fffdf8;
    padding: 8px 10px;
    color: #2a3d53;
    font-size: 0.86rem;
    font-weight: 800;
  }

  .profile-note {
    align-self: center;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: #fffdf8;
    padding: 18px;
    text-align: center;
    box-shadow: 9px 9px 0 rgba(23, 49, 66, 0.06);
  }

  .profile-note img {
    width: 132px;
    height: 132px;
    border-radius: 34px;
    object-fit: cover;
  }

  .profile-note strong {
    display: block;
    margin-top: 12px;
    font-size: 1.1rem;
  }

  .profile-note p {
    margin: 4px 0 16px;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  .stats span {
    color: var(--muted);
    font-size: 0.72rem;
  }

  .stats b {
    display: block;
    color: var(--ink);
    font-size: 1.1rem;
  }

  .hand-note {
    position: absolute;
    right: 330px;
    bottom: 42px;
    max-width: 260px;
    transform: rotate(-2deg);
    border: 1px solid #ead4aa;
    background: #fff3c9;
    padding: 18px;
    color: #263c55;
    font-weight: 800;
    box-shadow: 0 12px 20px rgba(23, 37, 54, 0.08);
  }

  .now-strip {
    padding: 22px 24px;
  }

  .timeline-line {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-top: 14px;
  }

  .timeline-line span {
    position: relative;
    border-top: 3px solid #1d4ed8;
    padding-top: 12px;
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 700;
  }

  .timeline-line b {
    display: block;
    color: var(--ink);
  }

  .post-list {
    display: grid;
    gap: 14px;
  }

  .plain-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #c2410c;
    font-weight: 900;
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 270px;
    gap: 22px;
  }

  .sticky-notes {
    display: grid;
    align-content: start;
    gap: 16px;
    padding-top: 46px;
  }

  .memo {
    padding: 20px;
  }

  .memo.yellow {
    transform: rotate(1.5deg);
    background: #fff1bf;
  }

  .memo span {
    color: #c2410c;
    font-size: 0.78rem;
    font-weight: 900;
  }

  .memo p {
    margin: 8px 0 0;
    font-size: 1.05rem;
    font-weight: 800;
  }

  .memo a {
    display: block;
    margin-top: 10px;
    color: var(--ink);
    font-weight: 800;
  }

  .double-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .mini-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  @media (max-width: 980px) {
    .hero,
    .split,
    .double-grid {
      grid-template-columns: 1fr;
    }

    .hand-note {
      position: relative;
      right: auto;
      bottom: auto;
      max-width: none;
    }

    .sticky-notes {
      grid-template-columns: repeat(2, 1fr);
      padding-top: 0;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding: 42px 20px 24px;
    }

    .timeline-line,
    .mini-grid,
    .sticky-notes {
      grid-template-columns: 1fr;
    }
  }
</style>
