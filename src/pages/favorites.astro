---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ToolFavoriteCard from "@/components/ToolFavoriteCard.astro";
import { favorites } from "@/data/favorites";

const categories = Array.from(new Set(favorites.map((item) => item.category)));
---

<BaseLayout title="收藏" description="Marchen 收藏的技术文档、工具和常去的地方。">
  <div class="page-shell page">
    <section class="page-hero paper-card">
      <p class="eyebrow">Favorites</p>
      <h1>收藏</h1>
      <p>外链收藏、技术文档、设计灵感和一些值得反复打开的网站。</p>
    </section>

    {categories.map((category) => (
      <section>
        <div class="section-header">
          <h2 class="section-title">{category}</h2>
        </div>
        <div class="grid-auto">
          {favorites.filter((item) => item.category === category).map((item) => (
            <ToolFavoriteCard title={item.title} description={item.description} href={item.url} icon={item.icon} label={item.category} />
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .page {
    display: grid;
    gap: 32px;
  }

  .page-hero {
    padding: 34px;
  }

  h1 {
    margin: 10px 0;
    font-size: clamp(2.3rem, 6vw, 4rem);
  }

  .page-hero p:last-child {
    margin: 0;
    color: var(--muted);
  }
</style>
