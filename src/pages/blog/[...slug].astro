---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import ArticleCard from "@/components/ArticleCard.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).filter((post) => !post.data.draft && post.data.visibility === "public");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const allPosts = (await getCollection("blog"))
  .filter((entry) => !entry.data.draft && entry.data.visibility === "public")
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const currentIndex = allPosts.findIndex((entry) => entry.id === post.id);
const nextPosts = allPosts.filter((entry) => entry.id !== post.id).slice(0, 3);
const readingMinutes = Math.max(1, Math.round((post.body?.length ?? 600) / 500));
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="page-shell article-layout">
    <main class="article-main">
      <header class="article-hero">
        <p class="eyebrow">{post.data.category}</p>
        <h1>{post.data.title}</h1>
        <p>{post.data.description}</p>
        <div class="article-meta">
          <span><Icon name="UserRound" size={16} /> Marchen</span>
          <time datetime={post.data.pubDate.toISOString()}><Icon name="CalendarDays" size={16} /> {post.data.pubDate.toLocaleDateString("zh-CN")}</time>
          <span><Icon name="Clock3" size={16} /> {readingMinutes} 分钟</span>
        </div>
        <div class="tag-row">
          {post.data.tags.map((tag) => <span class="tag">#{tag}</span>)}
        </div>
        {post.data.cover && <img class="cover" src={post.data.cover} alt="" />}
      </header>

      <section class="prose paper-card article-content">
        <Content />
      </section>

      <section class="continue">
        <div class="section-header">
          <div>
            <p class="eyebrow">Continue</p>
            <h2 class="section-title">继续阅读</h2>
          </div>
          <a class="plain-link" href="/blog">全部文章 <Icon name="ArrowRight" size={16} /></a>
        </div>
        <div class="related-grid">
          {nextPosts.map((entry) => (
            <ArticleCard href={`/blog/${entry.id}`} title={entry.data.title} description={entry.data.description} date={entry.data.pubDate} tags={entry.data.tags} cover={entry.data.cover} />
          ))}
        </div>
      </section>
    </main>

    <aside class="article-sidebar">
      <nav class="paper-card toc" aria-label="文章目录">
        <span class="tape" aria-hidden="true"></span>
        <h2>目录</h2>
        {headings.length > 0 ? (
          <ol>
            {headings.filter((heading) => heading.depth <= 3).map((heading) => (
              <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
            ))}
          </ol>
        ) : (
          <p>这篇文章暂无目录。</p>
        )}
      </nav>

      <section class="paper-card side-note">
        <h2>文章详情</h2>
        <p><Icon name="CalendarDays" size={16} /> 发布于 {post.data.pubDate.toLocaleDateString("zh-CN")}</p>
        <p><Icon name="Clock3" size={16} /> 约 {readingMinutes} 分钟阅读</p>
        <p><Icon name="BookMarked" size={16} /> 第 {currentIndex + 1} 篇公开文章</p>
      </section>

      <section class="paper-card side-note">
        <h2>评论预留</h2>
        <p>这里后续接入 Giscus，与 GitHub Discussions 关联文章评论。</p>
      </section>
    </aside>
  </article>
</BaseLayout>

<style>
  .article-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 28px;
  }

  .article-main {
    min-width: 0;
  }

  .article-hero {
    padding: 26px 0 22px;
  }

  h1 {
    max-width: 840px;
    margin: 12px 0 14px;
    font-size: clamp(2.35rem, 6vw, 4.6rem);
    line-height: 1.05;
    letter-spacing: 0;
  }

  .article-hero > p:not(.eyebrow) {
    max-width: 760px;
    margin: 0;
    color: var(--muted);
    font-size: 1.08rem;
  }

  .article-meta,
  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 16px;
  }

  .article-meta span,
  .article-meta time {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--muted);
    font-size: 0.88rem;
    font-weight: 800;
  }

  .cover {
    width: 100%;
    margin-top: 22px;
    border: 1px solid var(--line);
    border-radius: 16px;
    box-shadow: 0 18px 42px rgba(23, 37, 54, 0.1);
  }

  .article-content {
    padding: 28px;
  }

  .article-sidebar {
    position: sticky;
    top: 98px;
    display: grid;
    align-content: start;
    gap: 16px;
    height: max-content;
  }

  .toc,
  .side-note {
    padding: 20px;
  }

  .toc h2,
  .side-note h2 {
    margin: 0 0 12px;
    font-size: 1rem;
  }

  .toc ol {
    margin: 0;
    padding-left: 20px;
  }

  .toc a {
    color: #34465b;
    font-size: 0.9rem;
    font-weight: 800;
  }

  .side-note p {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 10px 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .continue {
    margin-top: 32px;
  }

  .related-grid {
    display: grid;
    gap: 14px;
  }

  .plain-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #c2410c;
    font-weight: 900;
  }

  @media (max-width: 980px) {
    .article-layout {
      grid-template-columns: 1fr;
    }

    .article-sidebar {
      position: static;
      order: -1;
    }
  }

  @media (max-width: 560px) {
    .article-content {
      padding: 20px;
    }
  }
</style>
