---
import Icon from "@/components/Icon.astro";
import { siteConfig } from "@/data/site";
---

<section class="music-player" aria-label="背景音乐播放器">
  <button class="music-toggle" type="button" aria-label="播放或暂停">
    <Icon name="Play" size={18} />
  </button>
  <div class="music-meta">
    <strong data-track-title>背景音乐</strong>
    <span data-track-artist>点击播放</span>
    <input data-progress type="range" min="0" max="100" value="0" aria-label="播放进度" />
  </div>
  <div class="music-controls">
    <button type="button" data-prev aria-label="上一首"><Icon name="SkipBack" size={16} /></button>
    <button type="button" data-next aria-label="下一首"><Icon name="SkipForward" size={16} /></button>
    <input data-volume type="range" min="0" max="1" step="0.01" value="0.45" aria-label="音量" />
  </div>
  <audio preload="metadata"></audio>
</section>

<script define:vars={{ playlist: siteConfig.musicPlaylist }}>
  const player = document.querySelector(".music-player");
  const audio = player?.querySelector("audio");
  const toggle = player?.querySelector(".music-toggle");
  const toggleIcon = toggle?.querySelector("svg");
  const title = player?.querySelector("[data-track-title]");
  const artist = player?.querySelector("[data-track-artist]");
  const progress = player?.querySelector("[data-progress]");
  const volume = player?.querySelector("[data-volume]");
  const prev = player?.querySelector("[data-prev]");
  const next = player?.querySelector("[data-next]");
  let index = 0;

  function setIcon(name) {
    if (!toggleIcon) return;
    toggleIcon.innerHTML = name === "pause"
      ? '<rect x="6" y="4" width="4" height="16" rx="1"></rect><rect x="14" y="4" width="4" height="16" rx="1"></rect>'
      : '<polygon points="6 3 20 12 6 21 6 3"></polygon>';
  }

  function loadTrack(nextIndex) {
    if (!audio || !playlist.length) return;
    index = (nextIndex + playlist.length) % playlist.length;
    const track = playlist[index];
    audio.src = track.src;
    if (title) title.textContent = track.title;
    if (artist) artist.textContent = track.artist;
    if (progress) progress.value = 0;
  }

  loadTrack(0);
  if (audio && volume) audio.volume = Number(volume.value);

  toggle?.addEventListener("click", async () => {
    if (!audio) return;
    try {
      if (audio.paused) {
        await audio.play();
        setIcon("pause");
        player?.classList.add("is-playing");
      } else {
        audio.pause();
        setIcon("play");
        player?.classList.remove("is-playing");
      }
    } catch {
      if (artist) artist.textContent = "请将音频放入 public/audio/";
    }
  });

  prev?.addEventListener("click", () => {
    loadTrack(index - 1);
    if (!audio?.paused) audio?.play();
  });

  next?.addEventListener("click", () => {
    loadTrack(index + 1);
    if (!audio?.paused) audio?.play();
  });

  audio?.addEventListener("timeupdate", () => {
    if (!progress || !audio.duration) return;
    progress.value = String((audio.currentTime / audio.duration) * 100);
  });

  progress?.addEventListener("input", () => {
    if (!audio || !audio.duration) return;
    audio.currentTime = (Number(progress.value) / 100) * audio.duration;
  });

  volume?.addEventListener("input", () => {
    if (!audio) return;
    audio.volume = Number(volume.value);
  });

  audio?.addEventListener("ended", () => {
    loadTrack(index + 1);
    audio.play();
  });
</script>

<style>
  .music-player {
    position: fixed;
    right: 22px;
    bottom: 22px;
    z-index: 50;
    display: grid;
    grid-template-columns: 40px minmax(0, 160px) auto;
    align-items: center;
    gap: 10px;
    max-width: calc(100vw - 32px);
    border: 1px solid #dccdb7;
    border-radius: 14px;
    background: rgba(255, 253, 248, 0.94);
    box-shadow: 0 16px 36px rgba(23, 37, 54, 0.14);
    padding: 10px;
    backdrop-filter: blur(14px);
  }

  button {
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    background: #fff7e8;
    color: var(--ink);
    transition: background 180ms ease-out, color 180ms ease-out;
  }

  button:hover {
    background: var(--accent-soft);
    color: #c2410c;
  }

  .music-toggle {
    width: 40px;
    height: 40px;
    border-radius: 12px;
  }

  .music-meta {
    min-width: 0;
  }

  .music-meta strong,
  .music-meta span {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .music-meta strong {
    font-size: 0.84rem;
  }

  .music-meta span {
    color: var(--muted);
    font-size: 0.72rem;
  }

  .music-controls {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .music-controls button {
    width: 30px;
    height: 30px;
    border-radius: 9px;
  }

  input[type="range"] {
    height: 18px;
    accent-color: var(--accent);
  }

  [data-progress] {
    width: 100%;
    margin-top: 3px;
  }

  [data-volume] {
    width: 54px;
  }

  @media (max-width: 640px) {
    .music-player {
      right: 12px;
      bottom: 12px;
      grid-template-columns: 40px minmax(0, 1fr);
      width: calc(100vw - 24px);
    }

    .music-controls {
      grid-column: 1 / -1;
      justify-content: end;
    }
  }
</style>
