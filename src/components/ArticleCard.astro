---
import Icon from "@/components/Icon.astro";

interface Props {
  href: string;
  title: string;
  description: string;
  date: Date;
  tags?: string[];
  cover?: string;
}

const { href, title, description, date, tags = [], cover } = Astro.props;
---

<article class="article-card paper-card">
  {cover && <img src={cover} alt="" loading="lazy" />}
  <div>
    <time datetime={date.toISOString()}>{date.toLocaleDateString("zh-CN", { month: "2-digit", day: "2-digit" })}</time>
    <h3><a href={href}>{title}</a></h3>
    <p>{description}</p>
    <div class="meta">
      {tags.slice(0, 3).map((tag) => <span class="tag">#{tag}</span>)}
      <a class="read-link" href={href}>阅读 <Icon name="ArrowRight" size={15} /></a>
    </div>
  </div>
</article>

<style>
  .article-card {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 16px;
    padding: 14px;
    transition: transform 180ms ease-out, box-shadow 180ms ease-out;
  }

  .article-card:hover {
    box-shadow: 0 20px 48px rgba(23, 37, 54, 0.12);
    transform: translateY(-2px);
  }

  img {
    width: 100%;
    height: 112px;
    border-radius: 10px;
    object-fit: cover;
  }

  time {
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 700;
  }

  h3 {
    margin: 3px 0 7px;
    font-size: 1.05rem;
    line-height: 1.35;
  }

  p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
  }

  .read-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-left: auto;
    color: #c2410c;
    font-size: 0.84rem;
    font-weight: 800;
  }

  @media (max-width: 560px) {
    .article-card {
      grid-template-columns: 1fr;
    }
  }
</style>
