---
import Icon from "@/components/Icon.astro";
import { siteConfig } from "@/data/site";
---

<footer class="site-footer">
  <div class="page-shell footer-grid">
    <div>
      <a class="footer-brand" href="/">
        <span class="brand-mark">M</span>
        <strong>{siteConfig.name}</strong>
      </a>
      <p>在成为更好的工程师之前，先成为更好的人。记录、分享、探索、成长。</p>
    </div>

    <div>
      <h2>常用标签</h2>
      <div class="footer-tags">
        <span># 前端</span>
        <span># 系统设计</span>
        <span># 项目日志</span>
        <span># 学习方法</span>
      </div>
    </div>

    <div>
      <h2>联系我</h2>
      <div class="footer-socials">
        {siteConfig.socials.map((item) => (
          <a href={item.href}>
            <Icon name={item.icon} size={18} />
            <span>{item.name}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
  <p class="copyright">© 2026 Marchen · Built with Astro, Tailwind CSS and Markdown.</p>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    background: rgba(255, 253, 248, 0.72);
    padding: 34px 0 24px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 28px;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 1.2rem;
    font-weight: 900;
  }

  .brand-mark {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 1px solid #d9c8ad;
    border-radius: 10px;
    background: #fff7e8;
    box-shadow: 5px 5px 0 rgba(249, 115, 22, 0.18);
  }

  p {
    max-width: 360px;
    margin: 14px 0 0;
    color: var(--muted);
  }

  h2 {
    margin: 0 0 12px;
    font-size: 0.9rem;
  }

  .footer-tags,
  .footer-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
  }

  .footer-tags span,
  .footer-socials a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    border: 1px solid var(--line);
    border-radius: 9px;
    background: #fffdf8;
    padding: 7px 10px;
    color: #34465b;
    font-size: 0.84rem;
    font-weight: 700;
  }

  .copyright {
    width: min(1180px, calc(100% - 32px));
    margin: 22px auto 0;
    color: var(--muted);
    font-size: 0.82rem;
  }

  @media (max-width: 760px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
