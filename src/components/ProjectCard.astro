---
import Icon from "@/components/Icon.astro";

interface Props {
  project: {
    name: string;
    description: string;
    techStack: string[];
    cover: string;
    github: string;
    demo: string;
    status: string;
  };
}

const { project } = Astro.props;
---

<article class="project-card paper-card">
  <img src={project.cover} alt={`${project.name} 项目截图`} loading="lazy" />
  <div class="content">
    <span class="status">{project.status}</span>
    <h3>{project.name}</h3>
    <p>{project.description}</p>
    <div class="stack">
      {project.techStack.map((item) => <span>{item}</span>)}
    </div>
    <div class="actions">
      <a href={project.demo}><Icon name="ExternalLink" size={16} /> 预览</a>
      <a href={project.github}><Icon name="Github" size={16} /> 源码</a>
    </div>
  </div>
</article>

<style>
  .project-card {
    overflow: hidden;
    transition: transform 180ms ease-out, box-shadow 180ms ease-out;
  }

  .project-card:hover {
    box-shadow: 0 20px 48px rgba(23, 37, 54, 0.12);
    transform: translateY(-2px);
  }

  img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .content {
    padding: 16px;
  }

  .status {
    color: #c2410c;
    font-size: 0.78rem;
    font-weight: 900;
  }

  h3 {
    margin: 4px 0 8px;
    font-size: 1.15rem;
  }

  p {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .stack,
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
  }

  .stack span {
    border: 1px solid #d8e1ee;
    border-radius: 8px;
    background: #f8fbff;
    padding: 4px 8px;
    color: #24446f;
    font-size: 0.76rem;
    font-weight: 800;
  }

  .actions a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--ink);
    font-size: 0.86rem;
    font-weight: 800;
  }
</style>
